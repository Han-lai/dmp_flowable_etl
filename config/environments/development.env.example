# 開發環境設定檔範例
# 複製此檔案為 development.env 並填入實際值

# ============================================
# ClickHouse 設定
# ============================================
CLICKHOUSE_HOST=REDACTED_IP
CLICKHOUSE_PORT=8121
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=default
CLICKHOUSE_DATABASE=default

# ============================================
# MSSQL 設定 (透過 JDBC Bridge)
# ============================================
MSSQL_HOST=twtpesqldv2.delta.corp
MSSQL_PORT=1433
MSSQL_USERNAME=DMP_APP_SRV
MSSQL_PASSWORD=APP@DB#01

# ============================================
# JDBC Bridge 設定
# ============================================
JDBC_BRIDGE_HOST=localhost
JDBC_BRIDGE_PORT=9019
JDBC_DATASOURCE_NAME=mssql_master

# ============================================
# Cube.js 設定
# ============================================
CUBEJS_DB_HOST=REDACTED_IP
CUBEJS_DB_PORT=8121
CUBEJS_DB_NAME=default
CUBEJS_DB_USER=default
CUBEJS_DB_PASS=default
CUBEJS_API_SECRET=your-secret-key-here

# ============================================
# 同步設定
# ============================================
SYNC_BATCH_SIZE=10000
SYNC_TIMEOUT_SECONDS=3600
SYNC_LOG_LEVEL=INFO

# ============================================
# 監控設定
# ============================================
MONITORING_ENABLED=true
ALERT_EMAIL=admin@company.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK