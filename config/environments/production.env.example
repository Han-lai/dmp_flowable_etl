# 生產環境設定檔範例
# 複製此檔案為 production.env 並填入實際值

# ============================================
# ClickHouse 設定
# ============================================
CLICKHOUSE_HOST=your-production-clickhouse-host
CLICKHOUSE_PORT=8121
CLICKHOUSE_USERNAME=production_user
CLICKHOUSE_PASSWORD=your-secure-password
CLICKHOUSE_DATABASE=production

# ============================================
# MSSQL 設定 (透過 JDBC Bridge)
# ============================================
MSSQL_HOST=your-production-mssql-host
MSSQL_PORT=1433
MSSQL_USERNAME=PROD_APP_SRV
MSSQL_PASSWORD=your-secure-password

# ============================================
# JDBC Bridge 設定
# ============================================
JDBC_BRIDGE_HOST=localhost
JDBC_BRIDGE_PORT=9019
JDBC_DATASOURCE_NAME=mssql_master

# ============================================
# Cube.js 設定
# ============================================
CUBEJS_DB_HOST=your-production-clickhouse-host
CUBEJS_DB_PORT=8121
CUBEJS_DB_NAME=production
CUBEJS_DB_USER=production_user
CUBEJS_DB_PASS=your-secure-password
CUBEJS_API_SECRET=your-production-secret-key

# ============================================
# 同步設定
# ============================================
SYNC_BATCH_SIZE=50000
SYNC_TIMEOUT_SECONDS=7200
SYNC_LOG_LEVEL=WARNING

# ============================================
# 監控設定
# ============================================
MONITORING_ENABLED=true
ALERT_EMAIL=ops-team@company.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/PRODUCTION/WEBHOOK

# ============================================
# 安全設定
# ============================================
SSL_ENABLED=true
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem